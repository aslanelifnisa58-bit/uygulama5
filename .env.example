# ============================================================
# LMS Akademi - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# ============================================================

# PostgreSQL veritabanı bağlantı URL'si
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Neon:     postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT için güçlü bir secret (en az 32 karakter)
# Oluşturmak için: openssl rand -base64 32
JWT_SECRET="change-this-to-a-very-long-random-secret-key-at-least-32-chars"

# Uygulama URL'si (Vercel'de otomatik ayarlanır)
NEXTAUTH_URL="http://localhost:3000"
